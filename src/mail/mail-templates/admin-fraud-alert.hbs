<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <style>
        #tableStyle,
        #tableStyle td,
        #tableStyle th {
            border: 1px solid;
            border-collapse: collapse;
            color: #505050;
        }

        #tableStyle th,
        #tableStyle td {
            padding: 5px;
            text-align: left;
            vertical-align: top;
        }
    </style>
</head>

<body style="margin:0;font-family:arial">
    <table style="border:0;width:100%">
        <tr style="background:rgba(150,150,150,0.2)">
            <td style="padding:20px;color:#004a80;text-align:left;font-size:30px;font-weight:600;">
                {{headerTitle}}
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#505050;font-size:16px;font-weight:100">
                <p>
                    <b>Gerado em:</b><br>
                    <span>{{generatedAtDate}}</span>
                    <span style="display:block;color:#707070;font-size:14px;">{{generatedAtTime}}</span>
                </p>
                <p>
                    <b>Limite até:</b><br>
                    <span>{{threshold}}</span>
                </p>
                <p>
                    <b>Ciclo de captura:</b><br>
                    <span>{{cicloInicio}} a {{cicloFim}}</span>
                    <span style="display:block;color:#707070;font-size:14px;">Pagamento previsto: {{dataPagamento}}</span>
                </p>
                <p><b>Fraude(s) Encontrada(s):</b> {{totalOrders}}</p>
                <p><b>Valor total:</b> {{totalValue}}</p>

                <table id="tableStyle">
                    <thead style="text-align: left;">
                        <tr>
                            <th>ID Usuário</th>
                            <th>Operadora</th>
                            <th>Consórcio</th>
                            <th>Qtd. Ordens</th>
                            <th>Valor Total no Ciclo</th>
                            <th>Primeira Captura</th>
                            <th>Última Captura</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each orders}}
                        <tr>
                            <td>{{userId}}</td>
                            <td>{{nomeOperadora}}</td>
                            <td>{{nomeConsorcio}}</td>
                            <td>{{quantidadeOrdens}}</td>
                            <td>{{valor}}</td>
                            <td>{{primeiraCaptura}}</td>
                            <td>{{ultimaCaptura}}</td>
                        </tr>
                        <tr>
                            <td colspan="7" style="background:rgba(150,150,150,0.08);">
                                <b style="font-size:13px;">Ordens de {{nomeOperadora}}:</b>
                                <table style="border-collapse:collapse;margin-top:4px;font-size:13px;">
                                    <tr>
                                        <th style="padding:2px 10px 2px 0;">ID</th>
                                        <th style="padding:2px 10px 2px 0;">ID Externo</th>
                                        <th style="padding:2px 10px 2px 0;">Data da Ordem</th>
                                        <th style="padding:2px 10px 2px 0;">Data de Captura</th>
                                        <th style="padding:2px 10px 2px 0;">Valor</th>
                                    </tr>
                                    {{#each ordens}}
                                    <tr>
                                        <td style="padding:2px 10px 2px 0;border:0;">{{id}}</td>
                                        <td style="padding:2px 10px 2px 0;border:0;">{{idOrdemPagamento}}</td>
                                        <td style="padding:2px 10px 2px 0;border:0;">{{dataOrdem}}</td>
                                        <td style="padding:2px 10px 2px 0;border:0;">{{dataCaptura}}</td>
                                        <td style="padding:2px 10px 2px 0;border:0;">{{valor}}</td>
                                    </tr>
                                    {{/each}}
                                </table>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
